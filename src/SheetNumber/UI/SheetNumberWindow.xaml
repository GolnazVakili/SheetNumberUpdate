<Window x:Class="SheetNumber.UI.SheetNumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Number"
        Width="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Text="Map Parameter I" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,4" Text="Source Parameter" />
                        <ComboBox x:Name="SourceParameterCombo" Height="28" MaxDropDownHeight="360" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="→" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,4" Text="Destination Parameter" />
                        <ComboBox x:Name="DestinationParameterCombo" Height="28" MaxDropDownHeight="360" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Text="Build the prefix" />
                <TextBlock Margin="0,0,0,4" Text="Parameter" />
                <ComboBox x:Name="PrefixTargetCombo" Height="28" MaxDropDownHeight="360" Margin="0,0,0,12" />
                <StackPanel x:Name="PrefixRows" />
                <Button x:Name="AddPrefixButton" Content="Add parameter" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="12,4" Click="AddPrefix_Click" />
                <CheckBox x:Name="SkipPrefixedCheckBox" Margin="0,12,0,0"
                          Content="Skip sheets whose destination already has this new value" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" Text="Map Parameter II" />
                <TextBlock Margin="0,0,0,4" Text="Parameter" />
                <ComboBox x:Name="ValueMapParameterCombo" Height="28" MaxDropDownHeight="360" Margin="0,0,0,8" />
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <Button Content="Load mapping file" Padding="12,4" DockPanel.Dock="Left" Click="LoadMappingFile_Click" />
                    <TextBlock x:Name="MappingFileText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555555" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ListView x:Name="ValueMapList" Height="150" BorderBrush="#D0D7E2">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Current value" DisplayMemberBinding="{Binding Current}" Width="310" />
                            <GridViewColumn Header="Mapped value" DisplayMemberBinding="{Binding Mapped}" Width="310" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

        <Border x:Name="PreviewBorder" Grid.Row="3" Background="#F4F7FB" BorderBrush="#D0D7E2" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PreviewButton" Content="Preview" Width="96" Height="30" Margin="0,0,8,0" Click="Preview_Click" />
            <Button x:Name="ApplyButton" Content="Apply" Width="96" Height="30" Margin="0,0,8,0" IsDefault="True" Click="Apply_Click" />
            <Button Content="Cancel" Width="96" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
